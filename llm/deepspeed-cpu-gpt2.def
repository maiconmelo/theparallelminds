Bootstrap: docker
From: python:3.10-slim

%post
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        wget \
        curl \
        ca-certificates \
        libopenmpi-dev \
        openmpi-bin \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*

    # Upgrade pip
    pip install --upgrade pip setuptools wheel

    # Install CPU-only PyTorch (key: use the CPU index to avoid pulling CUDA packages)
    pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu

    # Install DeepSpeed (compile CPU version from source)
    # Use DS_BUILD_OPS=0 to skip GPU-specific op compilation
    DS_BUILD_OPS=0 pip install deepspeed

    # Install Transformers and common training dependencies
    pip install transformers datasets accelerate

%environment
    export PYTHONUNBUFFERED=1
    # Limit OpenMP threads to avoid thread explosion during CPU training
    export OMP_NUM_THREADS=4
    # Disable tokenizers parallelism warning
    export TOKENIZERS_PARALLELISM=false

%runscript
    exec python "$@"

%test
    python -c "import torch; print('PyTorch:', torch.__version__); print('CUDA available:', torch.cuda.is_available())"
    python -c "import deepspeed; print('DeepSpeed:', deepspeed.__version__)"
    python -c "from transformers import AutoModelForCausalLM; print('Transformers OK')"